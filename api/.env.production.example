# 360tap.az API — production env nümunəsi (deploy platformasında təyin edin)
NODE_ENV=production
PORT=5500

# Managed Postgres (Render/Neon/Railway) — sslmode tələb oluna bilər
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB?schema=public&sslmode=require

# Güclü təsadüfi (≥32, ideal 64 simvol): openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Frontend domeni (Vercel) — CORS
CORS_ORIGINS=https://360tap-az.vercel.app

THROTTLE_TTL=60
THROTTLE_LIMIT=300

# Managed Redis (Render Key Value / Upstash)
REDIS_URL=redis://HOST:6379

# Meilisearch (private service / Meilisearch Cloud) — http:// prefiksli
MEILI_HOST=http://tap360-meili:7700
MEILI_KEY=CHANGE_ME_MEILI_MASTER_KEY

# Media — Faza 1 yerli disk (ephemeral!). Production üçün S3/R2 tövsiyə olunur.
MEDIA_DIR=./uploads
MEDIA_BASE_URL=https://tap360-api.onrender.com/uploads
