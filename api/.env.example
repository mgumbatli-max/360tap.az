# Marketplace API — nümunə mühit (real dəyərləri .env-ə yazın)
NODE_ENV=development
PORT=5500

# Database (lokal brew Postgres 16)
DATABASE_URL=postgresql://USER@localhost:5432/marketplace_dev?schema=public

# JWT (ən az 32 simvol)
JWT_SECRET=replace_with_long_random_secret_min_32_chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# CORS
CORS_ORIGINS=http://localhost:5401,http://localhost:5501

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=300

# Redis (brew service)
REDIS_URL=redis://localhost:6379

# Meilisearch (brew service)
MEILI_HOST=http://localhost:7700
MEILI_KEY=

# Media (Faza 0 — yerli fayl sistemi)
MEDIA_DIR=./uploads
MEDIA_BASE_URL=http://localhost:5500/uploads

# Groq AI (pulsuz — console.groq.com) — AI axtarış + elan yaratma
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Şəkillə axtarış üçün vision modeli (configuration.ts oxuyur)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- E-poçt (Resend) ---
# Boş buraxılsa mektub GÖNDƏRİLMİR, konsola yazılır (dev üçün normaldır).
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=360tap.az <no-reply@360tap.az>

# --- SMS / OTP ---
# twilio | http (lokal AZ aqreqator) | boş = konsol
SMS_PROVIDER=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=360tap
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# Mektublardakı linklərin bazası
PUBLIC_URL=http://localhost:5401

# E2E — Playwright dəstinin throttle limitini keçməsi üçün gizli açar.
# Boş buraxılsa keçid BAĞLIDIR. NODE_ENV=production olduqda kod bunu onsuz da rədd edir.
E2E_THROTTLE_BYPASS=

# Frontend middleware-in imzaladığı müştəri IP-si üçün paylaşılan sirr (Vercel ilə EYNİ).
# Boş buraxılsa imza yoxlanmır və rate limit köhnə (zəif) məntiqə düşür.
INTERNAL_IP_SECRET=
