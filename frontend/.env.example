# 360tap.az frontend (Next.js 15) — nümunə mühit.
# Real dəyərləri .env.local-a (lokal) və ya Vercel Project Settings → Environment
# Variables-a (canlı) yazın. Bu fayl yalnız SƏNƏDdir, heç yerdə oxunmur.

# --- SSR / proxy ---
# Backend origin-i (prefikssiz, sonda "/" OLMADAN). Server tərəfdəki fetch-lər və
# next.config.ts-dəki /api rewrites bunu istifadə edir.
# ⚠️ PRODUCTION-DA MÜTLƏQ TƏYİN EDİN. Təyin olunmasa kod səssizcə
# http://localhost:5500-ə düşür — Vercel-də bu, bütün SSR sorğularının
# uğursuzluğu (boş elan siyahıları) deməkdir.
API_ORIGIN=http://localhost:5500

# Brauzerdən görünən API bazası (klient tərəfli fetch-lər üçün).
# Adətən eyni origin-dən proxy: "/api" (next.config.ts rewrites) və ya tam URL.
NEXT_PUBLIC_API_URL=http://localhost:5500/api/v1

# Saytın kanonik ünvanı — canonical link, sitemap, robots.txt, OG şəkilləri.
NEXT_PUBLIC_SITE_URL=http://localhost:5401

# --- Meilisearch (brauzerdən birbaşa axtarış; yalnız SEARCH açarı, master DEYİL) ---
NEXT_PUBLIC_MEILI_HOST=
NEXT_PUBLIC_MEILI_SEARCH_KEY=

# --- Webmaster doğrulama meta teqləri (boş buraxıla bilər) ---
NEXT_PUBLIC_GOOGLE_VERIFY=
NEXT_PUBLIC_YANDEX_VERIFY=

# --- Sosial şəbəkə linkləri (footer; boş olanlar göstərilmir) ---
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TELEGRAM=
NEXT_PUBLIC_SOCIAL_WHATSAPP=

# --- E2E testləri (yalnız lokal/CI; production-da TƏYİN ETMƏYİN) ---
E2E_BASE_URL=http://localhost:5401
# Yazma (POST/PATCH/DELETE) testlərinə icazə — canlı bazada işlədilməməlidir.
E2E_ALLOW_WRITE=

# api/.env-dəki INTERNAL_IP_SECRET ilə EYNİ dəyər. Rate limit açarının düzgün
# hesablanması üçün lazımdır (bax frontend/middleware.ts).
INTERNAL_IP_SECRET=

# YALNIZ LOKAL E2E üçün: api/.env-dəki E2E_THROTTLE_BYPASS ilə eyni dəyər.
# Vercel-də TƏYİN OLUNMAMALIDIR — canlıda keçid onsuz da koda görə bağlıdır.
E2E_THROTTLE_BYPASS=
