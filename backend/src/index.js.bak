import 'dotenv/config';
import express from 'express';
import cors from 'cors';
import helmet from 'helmet';
import morgan from 'morgan';
import rateLimit from 'express-rate-limit';
import path from 'node:path';
import { createServer } from 'node:http';
import { attachSocket } from './socket.js';

import authRouter from './routes/auth.js';
import categoriesRouter from './routes/categories.js';
import citiesRouter from './routes/cities.js';
import listingsRouter from './routes/listings.js';
import uploadRouter from './routes/upload.js';
import favoritesRouter from './routes/favorites.js';
import notificationsRouter from './routes/notifications.js';
import complaintsRouter from './routes/complaints.js';
import savedSearchesRouter from './routes/saved-searches.js';
import searchRouter from './routes/search.js';
import importRouter from './routes/import.js';
import chatsRouter from './routes/chats.js';
import insightsRouter from './routes/insights.js';
import clientLogRouter from './routes/clientlog.js';
import voiceRouter from './routes/voice.js';
import imageSearchRouter from './routes/image-search.js';
import smartSearchRouter from './routes/smart-search.js';
import aiRouter from './routes/ai.js';
import realestateRouter from './routes/realestate.js';
import { errorHandler, notFound } from './middleware/error.js';

const app = express();
const PORT = process.env.PORT || 5400;

app.use(helmet({ crossOriginResourcePolicy: { policy: 'cross-origin' } }));
app.use(cors({ origin: process.env.CORS_ORIGIN?.split(',') || '*', credentials: true }));
app.use(express.json({ limit: '2mb' }));
app.use(morgan('dev'));

app.use('/uploads', express.static(path.resolve(process.env.UPLOAD_DIR || './uploads')));

app.use('/api/auth',           rateLimit({ windowMs: 60_000, max: 30 }), authRouter);
app.use('/api/categories',     categoriesRouter);
app.use('/api/cities',         citiesRouter);
app.use('/api/listings',       listingsRouter);
app.use('/api/upload',         rateLimit({ windowMs: 60_000, max: 30 }), uploadRouter);
app.use('/api/favorites',      favoritesRouter);
app.use('/api/notifications',  notificationsRouter);
app.use('/api/complaints',     complaintsRouter);
app.use('/api/saved-searches', savedSearchesRouter);
app.use('/api/search',         searchRouter);
app.use('/api/import',         importRouter);
app.use('/api/chats',          chatsRouter);
app.use('/api/insights',       insightsRouter);
app.use("/api/clientlog", clientLogRouter);
app.use("/api/voice",          voiceRouter);
app.use('/api/image-search', imageSearchRouter);
app.use('/api/ai',             aiRouter);
app.use('/api/realestate',     realestateRouter);

app.get('/api/health', (_req, res) => res.json({ ok: true, service: '360tap.az', ts: Date.now() }));

app.use(notFound);
app.use(errorHandler);

const server = createServer(app);
attachSocket(server);

server.listen(PORT, () => {
  console.log(`\n🚀 360tap.az API → http://localhost:${PORT}`);
  console.log(`   Health    → http://localhost:${PORT}/api/health`);
  console.log(`   WebSocket → ws://localhost:${PORT}/socket.io/\n`);
});
